<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="description" content="The Lord Seed Children School and College — nurturing minds, building character, and growing tomorrow's leaders.">
<title>The Lord Seed Children School and College</title>
<style>
:root{--green:#145b38;--deep:#093a25;--gold:#f4c542;--cream:#fffaf0;--ink:#203027;--muted:#65746a;--white:#fff}
*{box-sizing:border-box;scroll-behavior:smooth}
body{margin:0;font-family:Arial,Helvetica,sans-serif;color:var(--ink);line-height:1.6;background:#fff}
header{background:var(--deep);color:white;position:sticky;top:0;z-index:10;box-shadow:0 3px 12px #0002}
.topbar{max-width:1180px;margin:auto;padding:13px 20px;display:flex;align-items:center;justify-content:space-between;gap:16px}
.brand{display:flex;align-items:center;gap:12px;font-weight:800;line-height:1.2}
.crest{width:48px;height:48px;display:grid;place-items:center;background:var(--gold);color:var(--deep);border-radius:50%;font-size:25px;border:3px solid #fff}
.brand small{display:block;color:#f9dfa0;font-size:11px;letter-spacing:1.5px;margin-top:5px}
nav{display:flex;gap:8px;flex-wrap:wrap;justify-content:flex-end}
nav a{color:white;text-decoration:none;font-size:13px;font-weight:700;padding:8px 10px;border-radius:7px}
nav a:hover,nav a:focus{background:var(--gold);color:var(--deep)}
section{scroll-margin-top:90px}
.hero{background:linear-gradient(110deg,#093a25d9,#145b38a8),url('images/school-compound.jpg') center/cover;min-height:520px;display:flex;align-items:center;color:white}
.hero-inner{max-width:1180px;margin:auto;padding:65px 24px;width:100%;display:grid;grid-template-columns:1.1fr .9fr;gap:35px;align-items:center}
.eyebrow{color:var(--gold);font-weight:800;text-transform:uppercase;letter-spacing:2px;font-size:13px}
h1{font-size:clamp(35px,5vw,60px);line-height:1.08;margin:14px 0 20px}
.hero p{font-size:18px;max-width:620px;color:#f1f8f3}
.btn{display:inline-block;background:var(--gold);color:var(--deep);padding:12px 19px;border-radius:7px;text-decoration:none;font-weight:800;margin:8px 8px 0 0}
.btn.alt{background:transparent;border:2px solid white;color:white}
.visual{min-height:290px;border:2px dashed #ffffffa8;background:#ffffff12;border-radius:18px;display:flex;align-items:center;justify-content:center;text-align:center;padding:25px}
.visual strong{display:block;font-size:22px}
.wrap{max-width:1180px;margin:auto;padding:65px 22px}
.section-head{text-align:center;max-width:760px;margin:0 auto 35px}
.section-head h2{font-size:clamp(28px,4vw,40px);color:var(--deep);margin:0 0 10px}
.section-head p{color:var(--muted);margin:0}
.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
.card{background:white;border:1px solid #e3eae4;border-radius:14px;padding:25px;box-shadow:0 8px 22px #092c1710}
.card .icon{font-size:31px}
.card h3{color:var(--green);margin:10px 0}
.tint{background:var(--cream)}
.split{display:grid;grid-template-columns:1fr 1fr;gap:35px;align-items:center}
.compound{background:#e7f3e9;border-radius:18px;padding:18px;min-height:320px;overflow:hidden}
.sky{height:70px;background:#bce4f7;border-radius:10px 10px 0 0;text-align:right;padding:10px;font-size:26px}
.school-building{background:#f4dba2;border:4px solid #c78c36;text-align:center;padding:25px 10px 12px;color:#3e321e;font-weight:bold}
.roof{height:0;border-left:130px solid transparent;border-right:130px solid transparent;border-bottom:45px solid #b84e3b;margin:auto;width:0}
.windows{display:flex;justify-content:center;gap:14px;margin:15px}
.windows span{display:block;background:#9bd1ed;width:35px;height:45px;border:3px solid #fff}
.door{width:40px;height:58px;background:#8a5938;margin:auto;border-radius:4px 4px 0 0}
.lawn{height:50px;background:#5aa65b;text-align:center;padding:12px;color:white;font-weight:bold}
.photo-card{min-height:200px;border:1px solid #dce7df;border-radius:12px;overflow:hidden;background:#fff;box-shadow:0 8px 22px #092c1710;display:flex;flex-direction:column}.photo-card img{width:100%;height:200px;object-fit:cover;display:block}.photo-card strong{padding:12px 14px;color:var(--green)}\n.placeholder{min-height:220px;border:2px dashed #b5c7ba;border-radius:12px;display:grid;place-items:center;text-align:center;padding:18px;background:#f7fbf7;color:#52705d}
.placeholder span{font-size:36px;display:block}
.gallery{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
.gallery .placeholder{min-height:200px}
.staff{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}
.staff .placeholder{min-height:180px}
.pill{display:inline-block;background:#e7f4e9;color:var(--green);padding:6px 11px;border-radius:30px;font-size:12px;font-weight:800;margin:4px}
.notice{background:#fff5cf;border-left:5px solid var(--gold);padding:18px;border-radius:8px}
form{display:grid;gap:12px}
input,textarea,select{width:100%;padding:13px;border:1px solid #ccd8cf;border-radius:7px;font:inherit}
button{border:0;cursor:pointer;font:inherit}
footer{background:var(--deep);color:#e8f2eb;padding:35px 22px}
.footer-inner{max-width:1180px;margin:auto;display:flex;justify-content:space-between;gap:25px;flex-wrap:wrap}
footer a{color:var(--gold)}
.small{font-size:13px;color:var(--muted)}
@media(max-width:850px){.topbar{align-items:flex-start;flex-direction:column}nav{justify-content:flex-start}nav a{padding:7px 8px}.hero-inner,.split{grid-template-columns:1fr}.cards{grid-template-columns:1fr 1fr}.staff{grid-template-columns:1fr 1fr}}
@media(max-width:560px){.cards,.gallery{grid-template-columns:1fr}.hero{min-height:0}.hero-inner{padding:45px 20px}.wrap{padding:45px 18px}.staff{grid-template-columns:1fr 1fr}.brand{font-size:14px}}
</style>
</head>
